###############################################################################
# Unifocus — configuração única do ambiente (Docker Compose + Laravel)
# O docker-compose lê este arquivo automaticamente; o Laravel também.
###############################################################################

# ---------------------------------------------------------------------------
# Infra / Docker
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=unifocus

# UID/GID do dono do código no host (evita arquivos root no bind mount)
UID=1000
GID=1000

# Portas expostas no host (escolhidas para não colidir com outras stacks)
APP_PORT=8080
WHODB_PORT=8081
DB_PORT_HOST=5433

# ---------------------------------------------------------------------------
# Laravel
# ---------------------------------------------------------------------------
APP_NAME=Unifocus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Banco de dados — estas variáveis alimentam O CONTAINER postgres E o Laravel
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=unifocus
DB_USERNAME=unifocus
DB_PASSWORD=troque-esta-senha

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@unifocus.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# OAuth — Login com Google (Laravel Socialite)
# Crie as credenciais em https://console.cloud.google.com/apis/credentials
# e cadastre a "Authorized redirect URI" igual ao GOOGLE_REDIRECT_URI abaixo.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback
