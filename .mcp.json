{
    "mcpServers": {
        "laravel-boost": {
            "command": "docker",
            "args": [
                "exec",
                "-i",
                "unifocus_app",
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
        "stitch": {
            "serverUrl": "https://stitch.googleapis.com/mcp",
            "url": "https://stitch.googleapis.com/mcp",
            "headers": {
                "X-Goog-Api-Key": "[ENCRYPTION_KEY]"
            }
        }
    }
}